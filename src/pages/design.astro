---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WorkCard from "../components/WorkCard.astro";
import { site } from "../lib/site";
---
<Base page="design" title={`${site.name} — Design`}>
  <Topbar path="/design/" />
  <main>
    <section class="pad page">
      <div class="sec-head sf">
        <span class="kicker">Design<span class="kicker-zh">设计</span></span>
        <h1 class="sec-title" style="margin-top:14px">Keynotes, Workshops &amp; Posters<span class="sec-title-zh">讲演 · 培训 · 海报</span></h1>
      </div>
      <div class="work-list sf">
        {site.design.map((w) => <WorkCard w={w} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
