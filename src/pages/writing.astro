---
import Base from "../layouts/Base.astro";
import Topbar from "../components/Topbar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WorkCard from "../components/WorkCard.astro";
import { site } from "../lib/site";
---
<Base page="writing" title={`${site.name} — Writing`}>
  <Topbar path="/writing/" />
  <main>
    <section class="pad page">
      <div class="sec-head sf">
        <span class="kicker">Writing<span class="kicker-zh">写作</span></span>
        <h1 class="sec-title" style="margin-top:14px">Magazines, Papers &amp; Reports<span class="sec-title-zh">杂志 · 论文 · 报告</span></h1>
      </div>
      <div class="work-list sf">
        {site.writing.map((w) => <WorkCard w={w} />)}
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
