---
import { site } from "../lib/site";
import Icon from "./Icon.astro";
// The link for the current page is white, the rest sit at 60% (Framer current-page link style).
// Pages pass their own path ("/", "/404", "/projects/<slug>"), without the trailing slash.
interface Props {
  path: string;
}
const { path } = Astro.props;
const isCurrent = (href: string) => href === path;
---
<header class="topbar" data-topbar>
  <div class="topbar-bar container">
    <div class="topbar-logo">
      <a href="/" class="body" style="color: var(--white)">{site.name}</a>
      <p class="body muted topbar-sub">{site.role}</p>
    </div>
    <nav class="topbar-links" aria-label="Primary">
      {site.nav.map((l) => (
        <a class:list={["body-sb", { "is-current": isCurrent(l.href) }]} href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
          {l.label}<span class="nav-zh">{l.zh}</span>
        </a>
      ))}
    </nav>
    <button type="button" class="topbar-menu" aria-label="Open menu" aria-expanded="false" data-menu-btn>
      <span class="topbar-icon" data-icon-open><Icon name="menu" size={24} stroke={1} /></span>
      <span class="topbar-icon" data-icon-close style="opacity: 0"><Icon name="x" size={24} stroke={1} /></span>
    </button>
  </div>
  <nav class="topbar-mobile" aria-label="Mobile" aria-hidden="true" data-mobile-nav>
    {site.nav.map((l) => <a class:list={["h3", { "is-current": isCurrent(l.href) }]} href={l.href} tabindex="-1">{l.label} <span style="font-size:0.5em;color:var(--white-60);font-weight:400">{l.zh}</span></a>)}
  </nav>
</header>
